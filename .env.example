# ---------------------------------------------------------------------------
# ml-production-platform -- example configuration
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Nothing below is a real
# credential: these are local placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Holds the simulated source system, the feature store, the prediction log
# and the monitoring tables.
POLARIS_DB_HOST=localhost
POLARIS_DB_PORT=5432
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris_app
POLARIS_DB_PASSWORD=change_me_local_only

POLARIS_SOURCE_SCHEMA=saas
POLARIS_FEATURE_SCHEMA=features
POLARIS_ML_SCHEMA=ml

# --- Experiment tracking ---------------------------------------------------
# A local SQLite store by default -- MLflow 3 put the old `file:./mlruns`
# backend into maintenance mode and refuses to open one. Point this at a
# tracking server and nothing else in the project changes.
POLARIS_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
POLARIS_MLFLOW_EXPERIMENT=churn-60d

# --- The prediction problem ------------------------------------------------
# How far ahead the model predicts. Changing it changes the label, so every
# model trained under a different horizon is a different model.
POLARIS_HORIZON_DAYS=60
# How often an account is scored. Fortnightly, which is the cadence a customer
# success team can actually work a list at -- and, incidentally, what gives the
# temporal split enough reference dates to survive the embargo between train,
# validation and test.
#
# Labels are only known once the horizon has elapsed, so the most recent
# HORIZON_DAYS of history carries features but no label. That is not a tuning
# knob: it is the reason the training set stops where it does.
POLARIS_REFERENCE_INTERVAL_DAYS=14

# --- Economics of the decision ---------------------------------------------
# The threshold is chosen to maximise expected value, not F1. These three
# numbers are what make that possible, and they come from the business.
# Gross margin lost when an account churns (EUR, per account per year).
POLARIS_VALUE_OF_SAVED_ACCOUNT=9000
# Cost of the retention play: a CSM call, a discount offer, an incentive.
POLARIS_COST_OF_INTERVENTION=350
# Share of genuinely at-risk accounts a retention play actually saves.
POLARIS_INTERVENTION_SUCCESS_RATE=0.30

# --- Promotion gates -------------------------------------------------------
# A challenger must beat the champion by at least this much PR-AUC to be
# promoted. Anything smaller is noise on a test set this size.
POLARIS_MIN_PR_AUC_GAIN=0.005
# No segment may regress by more than this, whatever the overall number says.
POLARIS_MAX_SEGMENT_REGRESSION=0.03
# Calibration ceiling: a model whose probabilities are wrong is unusable for
# an expected-value threshold, however good its ranking is.
POLARIS_MAX_BRIER_SCORE=0.12
# Serving budget, p95, in milliseconds.
POLARIS_MAX_P95_LATENCY_MS=50

# --- Drift monitoring ------------------------------------------------------
# Population Stability Index thresholds, the conventional 0.1 / 0.25 split.
POLARIS_PSI_WARN=0.10
POLARIS_PSI_ALERT=0.25

# --- Data generation -------------------------------------------------------
POLARIS_RANDOM_SEED=20260301
POLARIS_N_ACCOUNTS=3000
POLARIS_HISTORY_MONTHS=24

# --- Paths -----------------------------------------------------------------
POLARIS_DATA_DIR=data

# --- Runtime ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
POLARIS_LOG_LEVEL=INFO
# text | json
POLARIS_LOG_FORMAT=text
